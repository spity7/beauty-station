NEXT_PUBLIC_REFRESH_TOKEN_MAX_AGE=604800

# Google sign-in button (@react-oauth/google) — must match server GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Path deploy only: NEXT_PUBLIC_BASE_URL=
